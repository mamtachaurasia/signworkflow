# Core application
# Local development. For Docker Compose, use:
# mongodb://admin:<MONGO_PASSWORD>@mongodb:27017/contract-esign?authSource=admin
MONGODB_URI=mongodb://127.0.0.1:27017/contract-esign
MONGO_PASSWORD=replace-with-a-long-random-value
NEXTAUTH_URL=http://localhost:3000
NEXT_PUBLIC_BASE_URL=http://localhost:3000
# New trial workspaces receive this many free days.
DEFAULT_TRIAL_DAYS=30
# Self-hosted production only: set this to the bare-IP header that your trusted
# reverse proxy always overwrites (for example, x-forwarded-for).
TRUSTED_PROXY_IP_HEADER=
JWT_SECRET=replace-with-a-long-random-value
# Optional RS256 PEM keys (auto-generated at runtime if omitted)
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
NEXTAUTH_SECRET=replace-with-a-different-long-random-value
REFRESH_TOKEN_PEPPER=replace-with-a-long-random-value
SUPPORT_SSO_SECRET=replace-with-a-different-long-random-value-shared-only-with-support
SUPPORT_PUBLIC_ORIGIN=https://support.signworkflow.com

# Storage: choose s3 or r2
STORAGE_PROVIDER=s3
ACCESS_AWS_KEY_ID=
SECRET_AWS_ACCESS_KEY=
REGION_AWS=us-east-1
S3_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_ENDPOINT=
R2_REGION=auto
R2_BUCKET_NAME=

# Email
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
CONTACT_EMAIL=contact@signworkflow.com
SALES_EMAIL=sales@signworkflow.com
PRESS_EMAIL=press@signworkflow.com

# Operational security
CRON_SECRET=replace-with-a-long-random-value
ADMIN_BOOTSTRAP_TOKEN=replace-with-a-long-random-value
AUDIT_LOG_HASH_PEPPER=replace-with-a-long-random-value
# Required in production for encrypted queued signing invitations. Use a
# dedicated 32-byte hex, base64, or plain-text key; do not reuse a cloud key.
SIGNING_TOKEN_ENCRYPTION_KEY=
RETENTION_ADMIN_TOKEN=replace-with-a-long-random-value
RETENTION_PURGE_TOKEN=replace-with-a-long-random-value

# Google authentication
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Search indexing (the default key matches public/b3f1a7e8d9c123456789abcdef.txt)
INDEXNOW_KEY=b3f1a7e8d9c123456789abcdef

# India billing (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_BUSINESS_MONTHLY=
RAZORPAY_PLAN_BUSINESS_ANNUALLY=
RAZORPAY_PLAN_BUSINESS_PLUS_MONTHLY=
RAZORPAY_PLAN_BUSINESS_PLUS_ANNUALLY=
RAZORPAY_PLAN_ENTERPRISE_MONTHLY=
RAZORPAY_PLAN_ENTERPRISE_ANNUALLY=

# International billing (PayPal)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=

# Optional AI provider
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# Optional analytics and maps
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_GOOGLE_MAP_API=

# Optional cloud exports
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
CLOUD_CONNECTIONS_ENCRYPTION_KEY=
