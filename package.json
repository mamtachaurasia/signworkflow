    "clsx": "^2.1.1",
    "cookie": "^1.0.2",
    "dotenv": "^17.3.1",
    "google-auth-library": "^10.5.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.525.0",
    "mongoose": "^8.15.1",
    "motion": "^12.38.0",
    "next": "^16.4.2",
    "nodemailer": "^10.1.3",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "5.4.296",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.62.0",
    "react-hot-toast": "^2.6.0",
    "react-markdown": "^10.1.0",
