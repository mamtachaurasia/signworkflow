    "react-phone-number-input": "^3.4.14",
    "react-redux": "^9.2.0",
    "react-rnd": "^10.5.1",
    "react-select": "^5.10.2",
    "react-select-country-list": "^2.2.3",
    "react-signature-canvas": "^1.1.0-alpha.2",
    "react-webcam": "^7.2.0",
