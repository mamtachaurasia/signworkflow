    "@types/react-select-country-list": "^2.2.3",
    "@types/react-signature-canvas": "^1.0.7",
    "@types/zxcvbn": "^4.4.5",
    "ajv": "^6.14.0",
    "eslint": "^9.39.2",
    "eslint-config-next": "^16.4.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jsdom": "^25.0.1",
    "mongodb-memory-server": "^10.1.4",
    "postcss": "^8",
    "tailwindcss": "^4.2.2",
    "typescript": "^5",
    "vitest": "^4.0.18"
  },
  "overrides": {
    "@aws-sdk/xml-builder": "^3.972.10",
    "ajv": "^6.14.0",
    "canvas": "^3.2.0",
    "fast-xml-parser": "^5.4.2",
    "glob": "^11.1.0",
    "minimatch": "^10.2.4",
    "pdfjs-dist": "5.4.296",
    "rollup": "^4.59.0",
    "rimraf": "^6.1.3",
    "source-map-js": "1.2.2"
  }
}
