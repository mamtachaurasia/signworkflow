{
  "name": "doc-esign",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@10.8.2",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "next dev --turbopack --hostname 127.0.0.1",
    "build": "NODE_OPTIONS=\"--require ./scripts/suppress-baseline-warning.cjs\" BROWSERSLIST_IGNORE_OLD_DATA=1 BASELINE_BROWSER_MAPPING_IGNORE_OLD_DATA=1 next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 app components config contexts hooks lib middleware models scripts store tests types utils proxy.ts next.config.ts playwright.config.ts tailwind.config.ts vitest.config.mts",
    "typecheck": "tsc --noEmit --pretty false --incremental false",
    "test:e2e": "npm run build && npm run test:e2e:run",
    "test:e2e:run": "playwright test",
    "test:e2e:headed": "npm run build && playwright test --headed",
    "test:e2e:report": "playwright show-report playwright-report",
    "test:unit": "NODE_OPTIONS=\"--max-old-space-size=4096\" vitest run --exclude tests/integration/**/*.test.ts",
    "test:unit:watch": "NODE_OPTIONS=\"--max-old-space-size=4096\" vitest --exclude tests/integration/**/*.test.ts",
    "test:integration": "vitest run tests/integration/",
    "preflight:prod": "bash scripts/production-preflight.sh",
    "backfill:signing": "node scripts/backfill-signing-data.js",
    "backfill:sent-at": "node scripts/backfill-sent-at.js",
    "backfill:released-holds": "node scripts/run-released-hold-retention-backfill.js",
    "purge:users": "node scripts/run-user-purge.js",
    "purge:retention": "node scripts/run-retention-purge.js",
    "seed:professional-template": "node scripts/seed-professional-template.js",
    "seed:system-templates": "node scripts/seed-system-templates.js",
    "migrate:template-artifacts": "node scripts/migrate-template-artifacts.js",
    "migrate:trial-duration": "node scripts/migrate-trial-duration.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1004.0",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dismissable-layer": "^1.1.11",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@react-oauth/google": "^0.12.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@tiptap/core": "^3.32.0",
    "@tiptap/extension-color": "^3.32.0",
    "@tiptap/extension-highlight": "^3.32.0",
    "@tiptap/extension-horizontal-rule": "^3.32.0",
    "@tiptap/extension-image": "^3.32.0",
    "@tiptap/extension-link": "^3.32.0",
    "@tiptap/extension-placeholder": "^3.32.0",
    "@tiptap/extension-subscript": "^3.32.0",
    "@tiptap/extension-superscript": "^3.32.0",
    "@tiptap/extension-table": "^3.32.0",
    "@tiptap/extension-table-cell": "^3.32.0",
    "@tiptap/extension-table-header": "^3.32.0",
    "@tiptap/extension-table-row": "^3.32.0",
    "@tiptap/extension-text-align": "^3.32.0",
